rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMaster() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.globalRole == "master";
    }

    function roomExists(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId));
    }

    function roomData(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function memberDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    // Uses exists() (not get().data != null) because calling .data on a
    // get() for a document that doesn't exist throws inside rules instead
    // of evaluating to false — which broke this check even when it should
    // have been short-circuited away by an earlier `||` clause.
    function isMember(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    function roleIn(roomId, roles) {
      return isMember(roomId) && memberDoc(roomId).data.role in roles;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.globalRole == resource.data.globalRole;
      allow delete: if false;

      // Denormalized "my rooms" index — fully scoped to the user's own
      // subtree, so this is always just request.auth.uid == uid.
      match /rooms/{roomId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Maps a room's invite code -> roomId, so a user can resolve a code
    // without needing list/query access to the rooms collection itself.
    match /roomCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      // "create" only fires when no document exists yet at this path, so
      // this also enforces first-write-wins uniqueness for the code.
      allow create: if isSignedIn() && request.resource.data.roomId is string;
      allow update, delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn() && (isMember(roomId) || isMaster());
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if roleIn(roomId, ["owner"]) || isMaster();
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isSignedIn()
          && (request.auth.uid == memberId || isMember(roomId) || isMaster());

        // Joining a room always creates your own member doc. You may only
        // self-assign "owner" when you are the room's real owner (checked
        // against the already-committed room doc); any other case must be
        // "member" — promotion to admin happens via a separate update by
        // the owner. The room must not be soft-deleted.
        allow create: if isSignedIn() && request.auth.uid == memberId
          && roomExists(roomId) && roomData(roomId).deletedAt == null
          && (
            (request.resource.data.role == "owner" && roomData(roomId).ownerId == request.auth.uid)
            || request.resource.data.role == "member"
          );

        allow update: if roleIn(roomId, ["owner"]) || isMaster();
        allow delete: if (isSignedIn() && request.auth.uid == memberId)
          || roleIn(roomId, ["owner"]) || isMaster();
      }

      match /items/{itemId} {
        allow read: if isSignedIn() && (isMember(roomId) || isMaster());
        allow create: if roleIn(roomId, ["owner", "admin"]) || isMaster();
        allow update, delete: if roleIn(roomId, ["owner", "admin"]) || isMaster();

        match /votes/{voteId} {
          allow read: if isSignedIn() && (isMember(roomId) || isMaster());
          allow create, update: if isSignedIn() && request.auth.uid == voteId
            && (isMember(roomId) || isMaster());
          allow delete: if false;
        }
      }
    }
  }
}
